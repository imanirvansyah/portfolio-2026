---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SmokeCanvas from '../components/SmokeCanvas.astro';
import Curtain from '../components/Curtain.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import WorkReel from '../components/WorkReel.astro';
import Services from '../components/Services.astro';
import Experience from '../components/Experience.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { site, liveSocials } from '../data/site';

const work = (await getCollection('work', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.url,
  jobTitle: site.jobTitle,
  description: site.description,
  sameAs: liveSocials().map((s) => s.href),
};
---

<Base jsonLd={jsonLd}>
  <SmokeCanvas />
  <Curtain />
  <Nav />
  <div class="page">
    <main id="top">
      <Hero />
      <div class="panel panel-home" data-panel>
        <WorkReel items={work} />
        <Services />
        <Experience />
      </div>
      <Contact />
    </main>
    <Footer />
  </div>
</Base>

<style>
  /* Breathing room between the hero and the solid panel, so the panel's entrance never meets the headline */
  .panel-home { margin-top: clamp(96px, 16vh, 180px); }
</style>

<script>
  import { bootHome } from '../scripts/boot';
  bootHome();
</script>
