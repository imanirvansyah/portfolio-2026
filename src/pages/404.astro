---
import Base from '../layouts/Base.astro';
import SmokeCanvas from '../components/SmokeCanvas.astro';
import Nav from '../components/Nav.astro';
---

<Base title="Page not found" noindex>
  <SmokeCanvas />
  <Nav />
  <div class="page">
    <main class="lost">
      <h1 class="title" data-page-title><span class="m"><span class="mi">Lost in the smoke.</span></span></h1>
      <p data-page-intro><a href="/">Back to the home page</a></p>
    </main>
  </div>
</Base>

<style>
  .lost { min-height: 100vh; min-height: 100svh; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 0 var(--pad); }
  .title { margin: 0; font-family: var(--display); font-weight: 700; font-size: var(--fs-h2); line-height: 0.95; color: var(--ink); }
  p { margin: 28px 0 0; }
  a { color: var(--text); text-underline-offset: 5px; }
  a:hover { color: var(--red); }
</style>

<script>
  import { bootPage } from '../scripts/boot';
  bootPage();
</script>
