---
import type { CollectionEntry } from 'astro:content';
import ProjectMedia from './ProjectMedia.astro';

interface Props {
  entry: CollectionEntry<'work'>;
  href: string;
  cta: string;
}

const { entry, href, cta } = Astro.props;
const d = entry.data;
const hasMedia = Boolean(d.media || d.cover);
---

<a
  class="card"
  href={href}
  data-ratio={d.ratio}
  data-kind={d.kind}
  data-name={d.title}
  data-type={d.type}
  data-cta={cta}
  data-media={hasMedia ? '' : undefined}
  style={`--tone:${d.tone}`}
  draggable="false"
>
  <span class="card-media">
    {
      hasMedia ? (
        <ProjectMedia data={d} widths={[480, 832, 1280]} sizes="(max-width: 760px) 90vw, 832px" />
      ) : (
        <>
          <span class="ph-ratio">{d.ratio}</span>
          {d.placeholder && <span class="ph-note">{d.placeholder}</span>}
        </>
      )
    }
    <span class="ph-name">{d.title}</span>
  </span>
</a>

<style>
  .card {
    position: relative; flex: none; display: block; height: var(--card-h);
    color: var(--ink); text-decoration: none; opacity: 0.42; transition: opacity 0.7s var(--ease-out);
  }
  .card:global(.is-selected), .card:focus-visible { opacity: 1; }
  .card[data-ratio='16:10'] { aspect-ratio: 16 / 10; }
  .card[data-ratio='9:16'] { aspect-ratio: 9 / 16; }
  .card[data-ratio='4:5'] { aspect-ratio: 4 / 5; }
  .card[data-ratio='1:1'] { aspect-ratio: 1 / 1; }

  .card-media {
    position: absolute; inset: 0; overflow: hidden; border-radius: 6px;
    border: 1px solid rgba(237, 220, 224, 0.08);
    background: radial-gradient(120% 90% at 28% 18%, var(--tone, #4a1c22) 0%, #1a0708 58%, #0a0405 100%);
  }
  .card-media :global(img), .card-media :global(video), .card-media :global(picture) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; pointer-events: none; }
  .card[data-media] .card-media::after { content: ''; position: absolute; inset: 40% 0 0 0; background: linear-gradient(transparent, rgba(5, 2, 3, 0.75)); }

  /* Placeholder frames, one per kind */
  .card[data-kind='app'] .card-media { border-radius: 26px; }
  .card[data-kind='app']:not([data-media]) .card-media::before {
    content: ''; position: absolute; top: 12px; left: 50%; width: 34%; height: 18px; margin-left: -17%; border-radius: 10px; background: #050203;
  }
  .card[data-kind='web']:not([data-media]) .card-media::before {
    content: ''; position: absolute; left: 0; right: 0; top: 0; height: 28px; border-bottom: 1px solid rgba(237, 220, 224, 0.08);
    background:
      radial-gradient(circle at 16px 14px, rgba(237, 220, 224, 0.25) 3px, transparent 3.5px),
      radial-gradient(circle at 30px 14px, rgba(237, 220, 224, 0.18) 3px, transparent 3.5px),
      radial-gradient(circle at 44px 14px, rgba(237, 220, 224, 0.12) 3px, transparent 3.5px);
  }
  .card[data-kind='deck']:not([data-media]) .card-media::before {
    content: ''; position: absolute; inset: 14px; border: 1px solid rgba(237, 220, 224, 0.14); border-radius: 4px;
  }

  .ph-name {
    position: absolute; z-index: 1; left: 18px; right: 18px; bottom: 16px;
    font-family: var(--display); font-weight: 700; font-size: clamp(26px, 2.6vw, 46px); line-height: 0.92; color: var(--ink);
  }
  .ph-ratio { position: absolute; right: 14px; top: 10px; font-size: 12px; color: var(--muted); font-variant-numeric: tabular-nums; }
  .ph-note { position: absolute; left: 18px; top: 44px; font-size: 12px; color: var(--muted); }
  .card[data-kind='web'] .ph-ratio { top: 6px; }
  .card[data-kind='app'] .ph-ratio { top: 40px; right: 16px; }
  .card[data-kind='deck'] .ph-note { top: 28px; left: 28px; }
  .card[data-kind='deck'] .ph-name { left: 28px; bottom: 26px; }
</style>
