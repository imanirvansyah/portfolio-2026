---
import type { CollectionEntry } from 'astro:content';
import WorkCard from './WorkCard.astro';

interface Props {
  items: CollectionEntry<'work'>[];
}

const { items } = Astro.props;
const cards = items.map((entry) => {
  const d = entry.data;
  const link = d.links[0];
  return {
    entry,
    href: d.caseStudy ? `/work/${entry.id}/` : (link?.href ?? '#'),
    cta: d.caseStudy ? 'Case study' : (link?.label ?? 'View project'),
  };
});
const first = cards[0];
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="sec work" id="work" aria-labelledby="work-title">
  <div class="sec-head">
    <h2 class="h2" id="work-title" data-mask><span class="m"><span class="mi">Selected work</span></span></h2>
    <p class="sec-note" data-lines>Products, websites and lab experiments. Drag to browse, or let it drift.</p>
  </div>

  <div class="reel" id="reel" data-cursor="drag">
    <div class="reel-track" id="reelTrack">
      {cards.map((c) => <WorkCard entry={c.entry} href={c.href} cta={c.cta} />)}
    </div>
  </div>

  {
    first && (
      <div class="reel-caption" aria-live="polite">
        <span class="rule" aria-hidden="true" />
        <p class="cap-num"><span class="m"><span class="mi" id="capNum">{`${pad(1)}/${pad(cards.length)}`}</span></span></p>
        <div class="cap-main">
          <p class="cap-name"><span class="m"><span class="mi" id="capName">{first.entry.data.title}</span></span></p>
          <p class="cap-type"><span class="m"><span class="mi" id="capType">{first.entry.data.type}</span></span></p>
        </div>
        <a class="cap-link" id="capLink" href={first.href}>{first.cta}</a>
        <div class="reel-ctrl">
          <button type="button" id="reelPrev" aria-label="Previous project">Prev</button>
          <button type="button" id="reelNext" aria-label="Next project">Next</button>
        </div>
      </div>
    )
  }
</section>

<style>
  .work { padding-left: 0; padding-right: 0; --card-h: clamp(260px, 50vh, 520px); }
  .sec-head { padding: 0 var(--pad); }

  .reel { position: relative; overflow: hidden; cursor: grab; touch-action: pan-y; -webkit-user-select: none; user-select: none; padding: 4px 0; }
  .reel:global(.is-dragging) { cursor: grabbing; }
  .reel-track { display: flex; gap: clamp(12px, 1.6vw, 24px); width: max-content; will-change: transform; }

  .reel-caption {
    position: relative; display: grid; grid-template-columns: auto minmax(0, 1fr) auto auto; align-items: center;
    column-gap: clamp(16px, 2.4vw, 40px); padding: 22px var(--pad) 0;
  }
  .reel-caption .rule { left: var(--pad); right: var(--pad); }
  .cap-num { margin: 0; font-size: 14px; color: var(--red); font-variant-numeric: tabular-nums; }
  .cap-main { min-width: 0; display: flex; align-items: baseline; gap: 18px; flex-wrap: wrap; }
  .cap-name { margin: 0; font-family: var(--display); font-weight: 700; font-size: clamp(30px, 3vw, 52px); line-height: 0.95; color: var(--ink); }
  .cap-type { margin: 0; font-size: 14px; color: var(--muted); }
  .cap-link {
    color: var(--text); font-size: 15px; min-height: 44px; display: inline-flex; align-items: center;
    text-decoration: underline; text-underline-offset: 5px; text-decoration-color: rgba(181, 174, 178, 0.35);
  }
  .cap-link:hover { color: var(--red); text-decoration-color: var(--red); }
  .reel-ctrl { display: flex; gap: 8px; }
  .reel-ctrl button {
    font: inherit; font-size: 14px; color: var(--text); background: transparent; border: 1px solid var(--rule);
    border-radius: 22px; height: 44px; padding: 0 18px; cursor: pointer;
    transition: border-color 0.3s var(--ease-out), color 0.3s var(--ease-out);
  }
  .reel-ctrl button:hover { border-color: var(--red); color: var(--red); }

  @media (max-width: 760px) {
    .work { --card-h: min(48vh, calc((100vw - 40px) / 1.6)); }
    .reel-caption { grid-template-columns: auto minmax(0, 1fr); row-gap: 10px; }
    .cap-link, .reel-ctrl { grid-column: 1 / -1; }
  }
</style>
